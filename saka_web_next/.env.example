# Origin of the SAKA API. SERVER-SIDE ONLY — deliberately not NEXT_PUBLIC_*.
# The browser never talks to the API directly; it calls this app's /api/saka/*
# proxy, which attaches the bearer token from an httpOnly cookie.
#
# ORIGIN ONLY — "/api/v1" is appended by lib/api/http.ts.
SAKA_API_URL=http://127.0.0.1:8000

# Canonical origin. Used by app/sitemap.ts, app/robots.ts and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra hosts allowed to serve images, space- or comma-separated.
# MUST list the real S3/CDN host in production or every photo fails silently.
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional. Defaults to OpenStreetMap, which needs no key.

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
# Any {z}/{x}/{y} raster tile template. Defaults to OpenStreetMap, which needs
# no key. A tile host set here must ALSO appear in `img-src` in next.config.ts,
# or the browser blocks the tiles and the map renders as a blank grid with
# nothing in the server logs.
NEXT_PUBLIC_MAP_TILE_URL=

# ---------------------------------------------------------------------------
# Google AdSense (optional)
# ---------------------------------------------------------------------------
# BLANK MEANS OFF: no script is loaded, no slot renders, and the tighter CSP is
# kept. Set both to switch AdSense on — a publisher id with no slot ids fills
# nothing.
#
# The publisher id is genuinely public (it ships in the page source of every
# AdSense site); the AdSense API credential is not, and this app neither has nor
# needs one.
NEXT_PUBLIC_ADSENSE_CLIENT=
# placement:slotId pairs, comma separated.
# e.g. listings_inline:1234567890,footer:0987654321
NEXT_PUBLIC_ADSENSE_SLOTS=

# ---------------------------------------------------------------------------
# Build identity and developer credit
# ---------------------------------------------------------------------------
# Set NEXT_PUBLIC_DEVELOPER_NAME="" to remove the footer credit entirely.
NEXT_PUBLIC_DEVELOPER_NAME=
NEXT_PUBLIC_DEVELOPER_URL=
NEXT_PUBLIC_DEVELOPER_SUPPORT=
# Injected by CI so a screenshot from a developer's machine is never mistaken
# for a release build.
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BUILD_YEAR=
