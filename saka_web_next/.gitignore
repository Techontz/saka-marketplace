# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# `.env*` catches the real ones — .env, .env.local, .env.production — and it
# MUST stay that way. The two templates below are re-admitted explicitly: they
# hold no secrets, only the variable names and CHANGE ME markers, and without
# them a fresh clone gives the deployment operator nothing to configure from.
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
