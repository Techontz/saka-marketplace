# =============================================================================
# SAKA marketplace — PRODUCTION
# =============================================================================
# Copy to `.env.production` (or set in the hosting provider) and fill in.
# NEVER commit real values. Anything prefixed NEXT_PUBLIC_ is compiled into the
# client bundle and is world-readable — never put a secret behind that prefix.
# =============================================================================
#
# ENV PRECEDENCE — read this before deploying.
#
# Next resolves: .env.local  >  .env.production  >  .env
#
# `.env.local` is loaded in every environment except test, so a developer's
# `.env.local` left on a server SILENTLY OVERRIDES this file and the site comes
# up talking to 127.0.0.1 with no error. Either delete `.env.local` on the
# server, or supply the values in the process environment — a real env var
# outranks every .env file. lib/api/http.ts now refuses to boot a production
# build against a development origin, so this fails loudly rather than quietly.
# =============================================================================

# The API, reached SERVER-SIDE only. Deliberately not NEXT_PUBLIC_: the browser
# talks to this app's own /api/saka proxy, which is what keeps the access token
# in an httpOnly cookie. May therefore be a private-network address.
#
# ORIGIN ONLY — no path. lib/api/http.ts appends "/api/v1" itself, so a value
# ending in /api/v1 produces /api/v1/api/v1/... and every request 404s.
SAKA_API_URL=https://api.saka.africa

# This app's own public origin. Used for canonical URLs, OpenGraph and the
# sitemap — a wrong value here silently de-indexes the site.
NEXT_PUBLIC_SITE_URL=https://saka.africa

# Hosts allowed to serve images, beyond this origin (space or comma separated).
# The API's storage disk lives on a different host in production. An omitted
# host fails SILENTLY: every image renders blank with nothing in the logs.
#
# MUST BE SET AT BUILD TIME, not only at runtime. next.config.ts builds the
# Content-Security-Policy from this value, and Next evaluates headers() during
# `next build` and freezes the result into .next/routes-manifest.json. Supplying
# it only in the container's runtime environment produces a CSP with no CDN
# host, and every photo on the site is blocked by the browser.
#
# It must match the media host EXACTLY, scheme and all — the API's AWS_URL (or
# APP_URL when media is served from the API). "localhost" and "127.0.0.1" are
# different origins to a CSP; so are http and https.
NEXT_PUBLIC_IMAGE_HOSTS=https://api.saka.africa

# Raster tile template. Blank uses OpenStreetMap, which needs no key. A custom
# host must ALSO be added to `img-src` in next.config.ts.
NEXT_PUBLIC_MAP_TILE_URL=

# --- Google AdSense (optional) ----------------------------------------------
# Blank = off: no script, no slots, tighter CSP. Both are needed to switch on.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOTS=

# --- Credit and build identity ----------------------------------------------
# Set the name to "" to remove the footer credit entirely.
NEXT_PUBLIC_DEVELOPER_NAME=TechOn Software LLC
NEXT_PUBLIC_DEVELOPER_URL=https://www.techon.co.tz
NEXT_PUBLIC_DEVELOPER_SUPPORT=contact@techontz.com
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BUILD_YEAR=
