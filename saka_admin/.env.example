# Origin of the SAKA API. SERVER-SIDE ONLY — deliberately not NEXT_PUBLIC_*.
#
# The browser never talks to the API directly: it calls this app's /api/saka/*
# proxy, which attaches the bearer token from an httpOnly cookie. Keeping the
# origin off the client means the API can live on a private network, and an
# admin token is never reachable from JavaScript.
#
# ORIGIN ONLY — "/api/v1" is appended by src/lib/api/http.ts.
SAKA_API_URL=http://127.0.0.1:8000

# Extra hosts allowed to serve images, space- or comma-separated.
# MUST list the real S3/CDN host in production or moderation screens show
# blank boxes where the photos under review should be.
NEXT_PUBLIC_IMAGE_HOSTS=

# Footer credit and build identity. Blank name removes the credit.
NEXT_PUBLIC_DEVELOPER_NAME=
NEXT_PUBLIC_DEVELOPER_URL=
NEXT_PUBLIC_DEVELOPER_SUPPORT=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BUILD_YEAR=
