# =============================================================================
# SAKA administration portal — PRODUCTION
# =============================================================================
# Copy to `.env.production`. Never commit real values.
#
# This portal should not be publicly routable. Put it behind whatever network
# control you use (VPN, IP allow-list, SSO proxy) in addition to its own login —
# the application's permission model is the last line of defence, not the first.
# =============================================================================
#
# ENV PRECEDENCE — read this before deploying.
#
# Next resolves: .env.local  >  .env.production  >  .env
#
# `.env.local` is loaded in every environment except test, so a developer's
# `.env.local` left on a server SILENTLY OVERRIDES this file and the site comes
# up talking to 127.0.0.1 with no error. Either delete `.env.local` on the
# server, or supply the values in the process environment — a real env var
# outranks every .env file. lib/api/http.ts now refuses to boot a production
# build against a development origin, so this fails loudly rather than quietly.
# =============================================================================

# Server-side only.
#
# ORIGIN ONLY — no path. src/lib/api/http.ts appends "/api/v1" itself, so a
# value ending in /api/v1 produces /api/v1/api/v1/... and every request 404s.
SAKA_API_URL=https://api.saka.africa

# Hosts allowed to serve images, beyond this origin (space or comma separated).
# Moderation screens show the listing photos under review, so an omitted host
# means every moderator reviews blank boxes. Feeds the CSP in next.config.ts.
#
# MUST BE SET AT BUILD TIME: Next freezes headers() into
# .next/routes-manifest.json during `next build`, so a runtime-only value
# produces a CSP with no media host. Match the API's AWS_URL exactly.
NEXT_PUBLIC_IMAGE_HOSTS=https://api.saka.africa

NEXT_PUBLIC_DEVELOPER_NAME=TechOn Software LLC
NEXT_PUBLIC_DEVELOPER_URL=https://www.techon.co.tz
NEXT_PUBLIC_DEVELOPER_SUPPORT=contact@techontz.com
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BUILD_YEAR=
