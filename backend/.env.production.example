###############################################################################
# SAKA Marketplace API — production environment template
#
# Copy to `.env` on the server and fill in every value marked CHANGE ME.
# Nothing in this file is a working secret; it will not boot as-is, on purpose.
#
# After editing:  php artisan config:cache && php artisan queue:restart
###############################################################################

# ---------------------------------------------------------------- application
APP_NAME="SAKA"
APP_ENV=production

# php artisan key:generate --show
APP_KEY=                                  # CHANGE ME

# Never true in production: debug pages render the stack trace, the loaded
# config and every environment variable to anyone who triggers a 500.
APP_DEBUG=false

APP_URL=https://api.saka.africa
APP_LOCALE=en

# There is deliberately no APP_TIMEZONE here. The application stores and
# computes in UTC (config/app.php pins it), because day boundaries are load-
# bearing: `listing_views.viewed_on` is the unique key behind one-counted-view-
# per-client-per-day, and the nightly rollup and expiry sweeper both bucket on
# it. Moving the server to EAT would silently shift those buckets by three
# hours and double-count a day's views during the transition. Times are
# localised for display by the frontend, which is where locale belongs.

APP_FALLBACK_LOCALE=en

# Maintenance mode state must not live on a single web node's local disk when
# there is more than one, or `artisan down` only takes down the node it ran on.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# 12 is the Laravel default and a reasonable 2026 cost. Raise only after
# measuring: this runs on every login and is a deliberate CPU cost.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                         # CHANGE ME
DB_PORT=3306
DB_DATABASE=saka
DB_USERNAME=saka                          # CHANGE ME — not root
DB_PASSWORD=                              # CHANGE ME

# The application user needs SELECT/INSERT/UPDATE/DELETE only. Migrations run
# under a separate account with DDL rights during deploy, so a compromised app
# credential cannot DROP a table.

# ---------------------------------------------------------------- redis
#
# Redis is REQUIRED, not optional: cache, queue, sessions, rate limiting, the
# spatie permission cache and the buffered listing counters all live there.
# The app degrades but does not fail if Redis is briefly unavailable —
# CounterService falls back to direct writes — but it will be slow.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1                      # CHANGE ME
REDIS_PORT=6379
REDIS_PASSWORD=                           # CHANGE ME — require a password
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=saka_cache

QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# The API is STATELESS: it authenticates with Sanctum bearer tokens and issues
# no session cookie on /api/* routes (verified against production — zero
# Set-Cookie headers). This only scopes Laravel's own session cookie, which the
# API uses for nothing the four clients touch. The httpOnly cookies a browser
# shows for SAKA are set by the Next.js apps on THEIR domain, not by this API.
#
# Set it to the apex so a future stateful surface (Horizon, a first-party SPA)
# works across subdomains. It must match the deployed domain — a stale
# `.saka.co.tz` here scopes cookies to a domain the API no longer serves.
SESSION_DOMAIN=.saka.africa               # CHANGE ME

PERMISSION_CACHE_STORE=redis

HORIZON_PREFIX=saka_horizon:

# ---------------------------------------------------------------- filesystem
#
# `public` writes to the local disk and only works with one web node. Move to
# s3 before scaling out — the code path is identical, only this changes.
FILESYSTEM_DISK=s3
MEDIA_DISK=s3

AWS_ACCESS_KEY_ID=                        # CHANGE ME
AWS_SECRET_ACCESS_KEY=                    # CHANGE ME
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=saka-media                     # CHANGE ME
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://cdn.saka.africa           # CHANGE ME — CloudFront/CDN origin

MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_IMAGES_PER_LISTING=20

# ---------------------------------------------------------------- mail
MAIL_MAILER=smtp
MAIL_HOST=                                # CHANGE ME
MAIL_PORT=587
MAIL_USERNAME=                            # CHANGE ME
MAIL_PASSWORD=                            # CHANGE ME
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@saka.africa"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- logging
#
# stderr so the container/systemd journal owns log shipping. `daily` writes
# files nothing rotates off the disk.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------- SAKA
SAKA_FRONTEND_URL=https://saka.africa     # CHANGE ME — drives CORS and email links
SAKA_ADMIN_URL=https://admin.saka.africa  # CHANGE ME

# Additional exact CORS origins, comma-separated. Leave empty unless you have
# one — every entry here is a site allowed to call this API from a browser.
CORS_EXTRA_ORIGINS=
# Regex patterns for preview deploys, e.g. ^https://saka-git-[a-z0-9-]+\.vercel\.app$
# A loose pattern here is a full CORS bypass; anchor both ends.
CORS_ORIGIN_PATTERNS=

SAKA_DEFAULT_CURRENCY=TZS
SAKA_DEFAULT_COUNTRY=TZ
SAKA_LISTING_EXPIRY_DAYS=60

# Both are business rules, not toggles to flip under load.
SAKA_REQUIRE_PHONE_VERIFICATION=true
SAKA_REQUIRE_LISTING_MODERATION=true

# ---------------------------------------------------------------- auth
SANCTUM_TOKEN_TTL_MINUTES=1440
SANCTUM_REFRESH_TTL_MINUTES=43200

# Google sign-in. The id_token is verified server-side against Google's JWKS,
# so the client ID must match the one the frontend uses or every sign-in fails.
GOOGLE_CLIENT_ID=                         # CHANGE ME
GOOGLE_CLIENT_SECRET=                     # CHANGE ME

# ---------------------------------------------------------------- seeding
#
# The seeder REFUSES to create the super-admin without a password outside
# local, rather than defaulting to something guessable. Set this for the first
# deploy, then rotate the password through the app and clear this value.
SEED_ADMIN_EMAIL=admin@saka.africa        # CHANGE ME
SEED_ADMIN_PASSWORD=                      # CHANGE ME, then unset

# ---------------------------------------------------------------- observability
#
# /api/v1/metrics returns 404 without a matching X-Metrics-Token, so the
# endpoint is indistinguishable from a route that does not exist.
# Generate with:  openssl rand -hex 32
METRICS_TOKEN=                            # CHANGE ME

SLOW_QUERY_MS=500
SLOW_REQUEST_MS=2000

# ---------------------------------------------------------------------------
# Behind a load balancer / CDN
# ---------------------------------------------------------------------------
# Laravel reads the client IP from the socket unless the proxy is trusted. Left
# unset behind an ALB, Cloudflare or nginx, EVERY request appears to come from
# the proxy — which silently breaks the per-IP rate limiters (one visitor can
# exhaust everyone's budget) and makes `ip_hash` on listing views and ad clicks
# identical for the whole world.
#
# Use "*" only when the app is unreachable except through the proxy.
TRUSTED_PROXIES=

# Hosts that may use cookie (stateful) Sanctum auth. The three SAKA frontends
# authenticate with a Bearer token through their own server-side proxy, so this
# is normally left at the default; set it only if a first-party SPA is added
# that talks to the API directly from the browser.
SANCTUM_STATEFUL_DOMAINS=
