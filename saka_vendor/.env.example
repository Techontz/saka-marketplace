# Origin of the SAKA API. SERVER-SIDE ONLY — deliberately not NEXT_PUBLIC_*.
#
# The browser never talks to the API directly: it calls this app's /api/saka/*
# proxy, which attaches the bearer token from an httpOnly cookie.
# ORIGIN ONLY — "/api/v1" is appended by src/lib/api/http.ts.
SAKA_API_URL=http://127.0.0.1:8000

# Extra hosts allowed to serve images, space- or comma-separated.
# MUST list the real S3/CDN host in production or every photo fails silently.
NEXT_PUBLIC_IMAGE_HOSTS=

# Public marketplace origin, used for "view on the marketplace" links.
# NEXT_PUBLIC_ because it only ever builds a link the browser follows.
# Leave empty and those links are hidden rather than broken.
NEXT_PUBLIC_MARKETPLACE_URL=

# Map tiles for the land-boundary editor. Same rule as the marketplace: a host
# set here must also be allowed by the app's CSP.
NEXT_PUBLIC_MAP_TILE_URL=

# Footer credit and build identity. Blank name removes the credit.
NEXT_PUBLIC_DEVELOPER_NAME=
NEXT_PUBLIC_DEVELOPER_URL=
NEXT_PUBLIC_DEVELOPER_SUPPORT=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_BUILD_YEAR=
